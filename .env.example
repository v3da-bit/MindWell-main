# Copy this file to .env.local and fill in values from your providers.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

GEMINI_API_KEY=your-gemini-api-key
NEXT_PUBLIC_GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key

COSMICAUTH_SECRET=your-cosmic-auth-secret
COSMIC_PAYMENTS_SECRET=your-cosmic-payments-secret
COSMIC_DATABASE_SECRET=your-cosmic-database-secret
COSMIC_FILES_SECRET=your-cosmic-files-secret
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_BUILDER_API_KEY=your-builder-api-key
